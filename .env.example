# === API KEYS (optional — scrape works with ZERO keys via Bing/DuckDuckGo) ===
# SerpAPI for Google search results (better quality/limits when scaling).
SERPAPI_KEY=
# ScrapingBee for site rendering (JS-heavy pages) + premium proxies.
SCRAPINGBEE_API_KEY=
# Proxy list as comma-separated http://user:pass@host:port
PROXY_LIST=

# === SCRAPER TUNING ===
# Country to target for lead discovery (us, uk, ca, au, de, ...).
# High-ticket agencies usually sell into us/uk/ca/au markets.
SEARCH_COUNTRY=us
REQUEST_DELAY_MIN=1.5
REQUEST_DELAY_MAX=3.5
TIMEOUT_SECONDS=20
MAX_CONCURRENT_REQUESTS=4
USER_AGENT_ROTATE=true